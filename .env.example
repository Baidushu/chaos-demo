# ============================================================
# Chaos-Demo AI Platform — Environment Variables
# ============================================================
# Copy this file to .env and adjust for your environment.
#
#   cp .env.example .env
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=production          # production | staging | development

# ── Agent Mode ──────────────────────────────────────────────
AGENT_MODE=rule             # rule | ollama | auto

# ── LLM Provider ────────────────────────────────────────────
# mock: no real LLM, returns canned responses (default)
# ollama: uses local Ollama service
# openai_compatible: any OpenAI-compatible endpoint
AGENT_LLM_PROVIDER=mock
AGENT_LLM_MODEL=default
AGENT_LLM_TEMPERATURE=0.1
AGENT_LLM_MAX_TOKENS=2048
AGENT_LLM_TIMEOUT=30.0

# ── LLM Gateway（agent-eval planner / Judge / 故障诊断共用） ──
# provider: mock | ollama_chat | ollama_generate | openai_compatible
# 未设置时 planner/Judge 回退本地 Ollama，诊断回退规则匹配。
# DeepSeek 示例（key 写进本地 .env，勿提交）：
#   LLM_GATEWAY_PROVIDER=openai_compatible
#   LLM_GATEWAY_ENDPOINT=https://api.deepseek.com
#   LLM_GATEWAY_API_KEY=sk-xxxx
#   LLM_GATEWAY_MODEL=deepseek-chat
#   LLM_GATEWAY_TIMEOUT_SEC=60
LLM_GATEWAY_PROVIDER=
LLM_GATEWAY_ENDPOINT=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=
LLM_GATEWAY_TIMEOUT_SEC=60

# ── Platform Features ───────────────────────────────────────
# 1 = enabled, 0 = disabled
PLATFORM_OBSERVABILITY=1
PLATFORM_EVALUATION=0
PLATFORM_QUALITY_GATE=0
PLATFORM_TIMEOUT=60.0

# ── Observability ───────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
OBSERVABILITY_LOG_LEVEL=INFO

# ── Redis (for legacy tools_client & idempotency) ───────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── MySQL (placeholder — future data persistence) ───────────
MYSQL_ROOT_PASSWORD=chaos-demo-root
MYSQL_DATABASE=chaos_demo
MYSQL_USER=aiplatform
MYSQL_PASSWORD=aiplatform-pass
MYSQL_PORT=3306

# ── Service Ports ───────────────────────────────────────────
AI_PLATFORM_PORT=8000
